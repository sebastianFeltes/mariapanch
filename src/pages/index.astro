---
import Layout from '../layouts/Layout.astro';
import { social } from '../data/social';
import { iconClock, iconInstagram, iconMoto, iconTikTok, iconUtensils, iconX } from '../icons';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <main>
    <section class="hero">
      <div class="awning" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="marquee">
          <h1 class="brand">
            <img
              src={`${base}maria_panch_route_letters.png`}
              alt="María Panch"
              width="951"
              height="490"
              fetchpriority="high"
              decoding="async"
            />
          </h1>
          <p class="tagline">Súper panchos + papas. Te lo llevamos.</p>
          <div class="hero-actions">
            <a class="btn btn-whatsapp" href="#pedido">
              <Fragment set:html={iconUtensils} />
              Armá tu pedido
            </a>
            <a class="btn btn-ghost" href="#envios">
              <Fragment set:html={iconMoto} />
              Envíos
            </a>
          </div>
          <picture class="hero-maria">
            <source
              media="(min-width: 760px)"
              srcset={`${base}maria_no_bg_xl.webp`}
              type="image/webp"
            />
            <img
              src={`${base}maria_no_bg.png`}
              alt="María, con un súper pancho y papas"
              width="768"
              height="690"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <section class="section" id="pedido" aria-labelledby="pedido-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="pedido-title">Armá tu combo de pancho y papas</h2>
          <span class="ticket-label" id="pedido-ticket" hidden></span>
        </div>
        <div id="pedido-root" data-base={base}></div>
      </div>
    </section>

    <section class="section" id="envios">
      <div class="wrap info-grid">
        <article class="panel panel-horarios">
          <span class="stamp is-closed" id="open-badge">CERRADO</span>
          <h2><Fragment set:html={iconClock} /> Horarios</h2>
          <p class="hours">
            Jue–Vie–Sáb 19:00–00:00
            <small>El resto de la semana, descansamos.</small>
          </p>
        </article>

        <article class="panel panel-donde">
          <span class="stamp stamp-envio">ENVÍOS</span>
          <h2><Fragment set:html={iconMoto} /> Te lo llevamos</h2>
          <p class="hours">
            <small data-shipping-note>Envío $ 1.000. Depende de la zona.</small>
            <small>Consultá si llegamos.</small>
          </p>
          <a class="btn btn-naranja" href="#pedido">
            <Fragment set:html={iconUtensils} />
            Armá tu pedido
          </a>
        </article>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>María Panch — pancho de verdad.</p>
      <nav class="social-links social-links--footer" aria-label="Redes sociales">
        <a class="social-link" href={social.instagram} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={iconInstagram} />
          <span>Instagram</span>
        </a>
        <a class="social-link" href={social.tiktok} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={iconTikTok} />
          <span>TikTok</span>
        </a>
      </nav>
    </div>
  </footer>

  <div class="thanks-modal" id="thanks-modal" hidden>
    <button type="button" class="thanks-modal__backdrop" data-close-thanks aria-label="Cerrar"></button>
    <div
      class="thanks-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="thanks-title"
      tabindex="-1"
    >
      <button type="button" class="thanks-modal__close" data-close-thanks aria-label="Cerrar">
        <Fragment set:html={iconX} />
      </button>
      <img
        class="thanks-modal__medal"
        src={`${base}maria_medalla.png`}
        alt=""
        width="200"
        height="200"
        decoding="async"
      />
      <h2 class="thanks-modal__title" id="thanks-title">¡Gracias por tu pedido!</h2>
      <p class="thanks-modal__text">¡Que lo disfrutes!</p>
      <nav class="social-links social-links--modal" aria-label="Seguinos en redes">
        <a class="social-link" href={social.instagram} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={iconInstagram} />
          <span>Instagram</span>
        </a>
        <a class="social-link" href={social.tiktok} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={iconTikTok} />
          <span>TikTok</span>
        </a>
      </nav>
    </div>
  </div>

</Layout>

<script>
  import { mountOrder } from '../scripts/mount-order';
  import { mountThanksModal } from '../scripts/thanks-modal';

  const root = document.getElementById('pedido-root');
  const thanks = mountThanksModal();
  if (root) mountOrder(root, { onOrderSent: thanks.open });

  const openBadge = document.getElementById('open-badge');
  const openDays = new Set(['Thu', 'Fri', 'Sat']);

  const paintOpenBadge = () => {
    if (!openBadge) return;
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Argentina/Buenos_Aires',
      weekday: 'short',
      hour: 'numeric',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const day = parts.find((part) => part.type === 'weekday')?.value ?? '';
    const hour = Number(parts.find((part) => part.type === 'hour')?.value);
    const open = openDays.has(day) && hour >= 19;
    openBadge.textContent = open ? 'ABIERTO' : 'CERRADO';
    openBadge.classList.toggle('is-closed', !open);
  };

  paintOpenBadge();
  window.setInterval(paintOpenBadge, 60_000);
</script>
