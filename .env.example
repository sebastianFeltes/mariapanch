# URL de la implementación web (termina en /exec; no hace falta el id suelto)
PUBLIC_ORDERS_WEBAPP_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# Mismo valor que CONFIG.SECRET en google-apps-script/pedidos-webapp.gs
PUBLIC_ORDERS_SECRET=

# Opcional, queda en la columna version del Sheet
PUBLIC_APP_VERSION=1.0.0
